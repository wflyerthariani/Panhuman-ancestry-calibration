# Data never goes into git; only the directory skeleton does.
data_store/**
!data_store/**/
!data_store/**/.gitkeep

# Scope-specific region BEDs are regenerated by Stage 4.
resources/regions/*
!resources/regions/.gitkeep

logs/*
!logs/.gitkeep
reports/archive/*
!reports/archive/.gitkeep

# Python / tooling
__pycache__/
*.egg-info/
.pytest_cache/
.snakemake/
.DS_Store
