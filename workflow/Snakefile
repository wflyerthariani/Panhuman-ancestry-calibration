# Deliverable 1 pipeline. One target per stage; each stage's gate writes
# reports/status/<stage>.json and exits non-zero on fail, which halts downstream rules.
# Stages are added here as they are implemented (see README.md).

import os

if "scope" in config:
    os.environ["ANCAL_SCOPE"] = config["scope"]


rule stage0:
    output:
        "reports/status/stage0.json",
    log:
        "logs/stage0.log",
    shell:
        "(pytest -q && ancal check-env --pytest-ok 1 || ancal check-env --pytest-ok 0) > {log} 2>&1; "
        "cat {log}; grep -q '\"status\": \"pass\"' {output}"


rule stage1:
    input:
        "reports/status/stage0.json",
        "config/analysis.yaml",
        "config/data_sources.yaml",
    output:
        "reports/status/stage1.json",
        "reports/qc/config_status.md",
    log:
        "logs/stage1.log",
    shell:
        "ancal validate-config > {log} 2>&1; rc=$?; cat {log}; exit $rc"


rule stage2:
    input:
        "reports/status/stage1.json",
    output:
        "reports/status/stage2.json",
        "reports/manifests/software_manifest.tsv",
    log:
        "logs/stage2.log",
    shell:
        "ancal stage2 > {log} 2>&1; rc=$?; cat {log}; exit $rc"


rule stage3:
    input:
        "reports/status/stage2.json",
    output:
        "reports/status/stage3.json",
        "tables/sample_metadata.tsv",
        "tables/population_mapping.tsv",
        "tables/population_counts.tsv",
        "config/population_groups.yaml",
        "reports/qc/sample_count_report.md",
    log:
        "logs/stage3.log",
    shell:
        "ancal stage3 > {log} 2>&1; rc=$?; cat {log}; exit $rc"


rule stage4:
    input:
        "reports/status/stage3.json",
        "config/data_sources.yaml",
    output:
        "reports/status/stage4.json",
        "reports/qc/reference_report.md",
    log:
        "logs/stage4.log",
    shell:
        "ancal stage4 > {log} 2>&1; rc=$?; cat {log}; exit $rc"
